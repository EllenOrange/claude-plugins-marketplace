#!/usr/bin/env bash
#
# writing-plan-state -- hold the state of the writing plugin's plan loop
# outside every repository, in one directory per skill run on an issue,
# and move each file of it in and out on a caller's behalf.
#
# Every state path is composed here and nowhere else, so no agent ever
# names a path under the state root in a tool call or a Bash command.
# A hook that confines tool reads and writes to the current repository
# therefore never sees one. Content comes in through --from, a file the
# caller wrote inside its repository, and goes out on stdout.
#
# A put or an append that would leave ledger.md holding a repo-derived
# ruling with no checkable derivation is refused, and seed reopens such
# a ruling as a discuss item rather than copy it as repo-derived. The
# entry grammar is write-plan's "Define the ledger's entry classes".
#
# Exit status: 0 on success, 2 on a refused invocation, a refused
# ledger, or a state directory or file that could not be made, read or
# written, 3 when --mode print names a file the directory does not hold
# or --mode seed finds no write-plan state to seed from, 130 on an INT
# and 143 on a TERM. A refusal writes no file. A put or a seed that
# fails leaves no part of a file under the name it was writing, but a
# seed which could not stage ledger.md has already put evidence.md in
# place, and a later seed replaces that copy. An append that fails part
# way through its write can leave part of its records appended.
set -euo pipefail

readonly PROGRAM=${0##*/}

# die <message>: reports <message> on stderr and exits 2.
die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 2
}

# absent <message>: reports <message> on stderr and exits 3, the status
# for state the caller asked for that does not exist.
absent() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 3
}

# usage: prints the invocation synopsis and each mode's effect on stdout.
usage() {
  cat <<EOF
usage: $PROGRAM --repo <host>/<owner>/<repo> --skill write-plan|converge-plan
                --issue <n> --mode <mode> [--file <name>] [--from <path>]

modes:
  init                      create the directory and an empty evidence.md
  put --file <name> --from <path>
                            replace <name> with the file at <path>
  append --file <name> --from <path>
                            append the file at <path> to <name>
  print --file <name>       write <name> to stdout
  list                      list the directory's files, one per line
  seed                      copy write-plan's ledger.md and evidence.md
                            into converge-plan's directory, reopening
                            each repo-derived ruling with no checkable
                            derivation as a discuss item, and print the
                            first line of each entry it reopened

put and append refuse to leave ledger.md holding a repo-derived ruling
with no checkable derivation, and name each such entry on stderr.

--repo also takes https://<host>/<owner>/<repo>, the form
gh repo view --json url --jq .url prints.
EOF
}

repo_ref=
skill=
issue=
mode=
file=
from=

while [ "$#" -gt 0 ]; do
  flag=$1
  case "$flag" in
    --repo|--skill|--issue|--mode|--file|--from)
      [ "$#" -ge 2 ] || die "$flag needs a value"
      value=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $flag"
      ;;
  esac
  case "$flag" in
    --repo)  repo_ref=$value ;;
    --skill) skill=$value ;;
    --issue) issue=$value ;;
    --mode)  mode=$value ;;
    --file)  file=$value ;;
    --from)  from=$value ;;
  esac
done

case "$mode" in
  init|put|append|print|list|seed) ;;
  '') die "--mode is required" ;;
  *)  die "unknown --mode: $mode" ;;
esac

# The repository is three segments, each one level of the composed path.
# A segment holding anything but letters, digits, ., _ and - could add a
# directory level, and a segment of . or .. could climb out of the level
# it stands at, so either could compose a path outside the state root.
[ -n "$repo_ref" ] || die "--repo is required"
given=${repo_ref#https://}
given=${given%/}
bad_repo="--repo takes <host>/<owner>/<repo> or https://<host>/<owner>/<repo>: $repo_ref"
case "$given" in
  *://*|*/*/*/*|*//*|/*) die "$bad_repo" ;;
  ?*/?*/?*) ;;
  *) die "$bad_repo" ;;
esac
host=${given%%/*}
owner=${given#*/}
owner=${owner%/*}
repo=${given##*/}
for segment in "$host" "$owner" "$repo"; do
  case "$segment" in
    *[!A-Za-z0-9._-]*|.|..)
      die "a repository's segments may hold only letters, digits, ., _ and -, and none may be . or ..: $repo_ref" ;;
  esac
done

case "$skill" in
  write-plan|converge-plan) ;;
  '') die "--skill is required" ;;
  *)  die "--skill must be write-plan or converge-plan: $skill" ;;
esac

case "$issue" in
  '') die "--issue is required" ;;
  *[!0-9]*) die "--issue must be a number: $issue" ;;
esac

# A file name is one path segment, so it names a file in the directory
# and never a path out of it.
case "$mode" in
  put|append|print)
    [ -n "$file" ] || die "--file is required in --mode $mode"
    case "$file" in
      *[!A-Za-z0-9._-]*|.*) die "--file must be a plain name of letters, digits, ., _ and -, not starting with .: $file" ;;
    esac
    ;;
  *)
    [ -z "$file" ] || die "--file is not accepted in --mode $mode: $file"
    ;;
esac

case "$mode" in
  put|append)
    [ -n "$from" ] || die "--from is required in --mode $mode"
    [ -f "$from" ] || die "--from names no file: $from"
    [ -r "$from" ] || die "--from names a file that cannot be read: $from"
    ;;
  *)
    [ -z "$from" ] || die "--from is not accepted in --mode $mode: $from"
    ;;
esac

# The evidence log is a record for the critic and a later postmortem, so
# a record once appended is never rewritten.
if [ "$mode" = put ] && [ "$file" = evidence.md ]; then
  die "evidence.md is appended to and never replaced; use --mode append"
fi

# An empty append is a staging write that failed, not a record.
if [ "$mode" = append ] && [ ! -s "$from" ]; then
  die "--mode append takes records, and $from is empty"
fi

readonly state_root="${XDG_STATE_HOME:-$HOME/.local/state}/writing"
readonly repo_dir="$state_root/$host/$owner/$repo"
readonly dir="$repo_dir/$skill-$issue"

# ledger_scan <action> <evidence> <ledger>...: walks the entries of the
# ledger files, read as one ledger in the order given. An entry is a
# line opening with "- " and the indented or blank lines under it, and
# a field is one of those lines opening with two spaces and the field's
# name. A repo-derived entry, one whose first line carries
# [Repo-derived], is checkable when it holds a non-empty Derivation:
# field and a check: an Evidence: field, or both a Command: and an
# Output: field. Every Evidence: field must name a line the <evidence>
# log holds. With <action> faults it prints the first line of each
# repo-derived entry that is not checkable. With <action> reopen it
# prints the whole ledger with each such entry marked [Discuss] in place
# of [Repo-derived] and a Reopened: field added under it.
ledger_scan() {
  action=$1
  evidence=$2
  shift 2
  awk -v action="$action" -v evidence="$evidence" '
    function trim(text) {
      sub(/^[ \t]+/, "", text)
      sub(/[ \t]+$/, "", text)
      return text
    }
    function flush(   checkable, last, i) {
      if (count == 0) return
      checkable = derivation && !dangling && (cited || (command && output))
      last = count
      while (last > 1 && entry[last] == "") last--
      if (derived && !checkable) {
        if (action == "faults") print entry[1]
        sub(/\[Repo-derived\]/, "[Discuss]", entry[1])
      }
      if (action == "reopen") {
        for (i = 1; i <= count; i++) {
          print entry[i]
          if (i == last && derived && !checkable)
            print "  Reopened: seeded as repo-derived with no checkable derivation"
        }
      }
      count = 0
    }
    BEGIN {
      while ((getline line < evidence) > 0) record[trim(line)] = 1
    }
    /^- / {
      flush()
      entry[++count] = $0
      derived = index($0, "[Repo-derived]") > 0
      derivation = cited = dangling = command = output = 0
      next
    }
    count > 0 && (/^[ \t]/ || /^$/) {
      entry[++count] = $0
      if ($0 ~ /^  Derivation:[ \t]*[^ \t]/) derivation = 1
      else if ($0 ~ /^  Command:[ \t]*[^ \t]/) command = 1
      else if ($0 ~ /^  Output:/) output = 1
      else if ($0 ~ /^  Evidence:/) {
        cite = $0
        sub(/^  Evidence:/, "", cite)
        cite = trim(cite)
        if (cite != "" && (cite in record)) cited = 1
        else dangling = 1
      }
      next
    }
    {
      flush()
      if (action == "reopen") print
    }
    END { flush() }
  ' "$@"
}

# refuse_ledger <evidence> <ledger>...: exits 2, naming every
# repo-derived entry the ledger files hold with no checkable derivation,
# and returns 0 when they hold none.
refuse_ledger() {
  faults=$(ledger_scan faults "$@") || die "could not read the ledger to check it"
  [ -n "$faults" ] || return 0
  printf '%s: %s\n%s\n' "$PROGRAM" \
    "a repo-derived ruling needs a Derivation: field and a check, an Evidence: field naming an evidence.md line or a Command: and an Output: field; record it [Discuss] until it has them:" \
    "$faults" >&2
  exit 2
}

# staged names the staging file a write has not yet renamed into place.
# A failure, an INT or a TERM exits through the EXIT trap, which removes
# it and exits with the status the trap was entered with, even when the
# removal fails. A staging file a KILL leaves behind is skipped by list
# and blocks no later write.
staged=
trap 'status=$?; [ -z "$staged" ] || rm -f -- "$staged" || :; exit "$status"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# install_whole <source> <target>: lands <source> under a staging name
# and renames it into place once whole, so a writer killed mid-copy
# leaves no fragment under the target's name.
install_whole() {
  staged="$2.partial-$$"
  cp -- "$1" "$staged" || die "could not stage $2"
  mv -- "$staged" "$2" || die "could not stage $2"
  staged=
}

# opens_with <long> <short>: succeeds when <short> is empty or <long>
# opens with every byte of it. An absent <long> opens with nothing but
# the empty file.
opens_with() {
  size=$(wc -c < "$2" | tr -d ' ')
  [ "$size" -gt 0 ] || return 0
  [ -f "$1" ] || return 1
  head -c "$size" -- "$1" | cmp -s - "$2"
}

case "$mode" in
  init)
    mkdir -p -- "$dir" || die "could not make $dir"
    if [ ! -e "$dir/evidence.md" ]; then
      : > "$dir/evidence.md" || die "could not create $dir/evidence.md"
    fi
    ;;
  put)
    if [ "$file" = ledger.md ]; then
      refuse_ledger "$dir/evidence.md" "$from"
    fi
    mkdir -p -- "$dir" || die "could not make $dir"
    install_whole "$from" "$dir/$file"
    ;;
  append)
    # An append is judged by the ledger it would leave, so a ruling
    # whose fields are split across two appends is refused at the first.
    if [ "$file" = ledger.md ]; then
      if [ -f "$dir/ledger.md" ]; then
        refuse_ledger "$dir/evidence.md" "$dir/ledger.md" "$from"
      else
        refuse_ledger "$dir/evidence.md" "$from"
      fi
    fi
    mkdir -p -- "$dir" || die "could not make $dir"
    cat -- "$from" >> "$dir/$file" || die "could not append to $dir/$file"
    ;;
  print)
    [ -f "$dir/$file" ] || absent "$skill-$issue holds no $file"
    cat -- "$dir/$file" || die "could not print $dir/$file"
    ;;
  list)
    [ -d "$dir" ] || exit 0
    for found in "$dir"/*; do
      [ -f "$found" ] || continue
      # A staging file is a copy put or seed has not yet renamed into
      # place, or one killed before its rename, and is no file of the
      # state.
      case "$found" in
        *.partial-*) continue ;;
      esac
      printf '%s\n' "${found##*/}"
    done
    ;;
  seed)
    # The draft is not copied: converge-plan prints it from write-plan's
    # directory. A ledger or an evidence record converge-plan already
    # holds is its own run's state, so the seed refuses rather than
    # overwrite it.
    #
    # The ledger lands last, so a seed that failed or was interrupted
    # before it left no ledger.md and at most a copy of write-plan's
    # evidence.md. write-plan only appends to its log, so its current log
    # still opens with that copy, and replacing the copy loses no record.
    # An evidence.md holding bytes write-plan's log does not open with is
    # converge-plan's own, and only that refuses the seed.
    [ "$skill" = converge-plan ] || die "--mode seed takes --skill converge-plan"
    source_dir="$repo_dir/write-plan-$issue"
    [ -f "$source_dir/ledger.md" ] || absent "write-plan-$issue holds no ledger.md to seed from"
    [ ! -e "$dir/ledger.md" ] || die "converge-plan-$issue already holds a ledger.md"
    if [ -f "$dir/evidence.md" ] && ! opens_with "$source_dir/evidence.md" "$dir/evidence.md"; then
      die "converge-plan-$issue already holds evidence records write-plan-$issue does not"
    fi
    mkdir -p -- "$dir" || die "could not make $dir"
    if [ -f "$source_dir/evidence.md" ]; then
      install_whole "$source_dir/evidence.md" "$dir/evidence.md"
    else
      : > "$dir/evidence.md" || die "could not create $dir/evidence.md"
    fi
    # A ruling recorded with no checkable derivation is never handed on
    # as repo-derived: it arrives reopened, and its first line as
    # write-plan wrote it goes to stdout.
    ledger_scan faults "$dir/evidence.md" "$source_dir/ledger.md" ||
      die "could not read $source_dir/ledger.md"
    staged="$dir/ledger.md.partial-$$"
    ledger_scan reopen "$dir/evidence.md" "$source_dir/ledger.md" > "$staged" ||
      die "could not stage $dir/ledger.md"
    mv -- "$staged" "$dir/ledger.md" || die "could not stage $dir/ledger.md"
    staged=
    ;;
esac
